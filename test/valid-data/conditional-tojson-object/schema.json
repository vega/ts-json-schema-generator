{
  "$ref": "#/definitions/MyObject",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "MyObject": {
      "additionalProperties": false,
      "properties": {
        "nested": {
          "additionalProperties": false,
          "properties": {
            "foo": { "type": "number" },
            "bar": { "type": "string" }
          },
          "required": ["foo", "bar"],
          "type": "object"
        }
      },
      "required": ["nested"],
      "type": "object"
    }
  }
}
