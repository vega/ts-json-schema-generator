{
    "$ref": "#/definitions/MyTuple",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "MyTuple": {
            "type": "array",
            "minItems": 1,
            "items": [
                {
                    "$ref": "#/definitions/FirstItem"
                }
            ],
            "additionalItems": {
                "$ref": "#/definitions/AdditionalItem"
            }
        },
        "FirstItem": {
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean",
                    "const": true
                }
            },
            "required": [
                "id",
                "required"
            ],
            "type": "object"
        },
        "AdditionalItem": {
            "additionalProperties": false,
            "properties": {
                "value": {
                    "type": "number"
                },
                "optional": {
                    "type": "boolean"
                }
            },
            "required": [
                "value"
            ],
            "type": "object"
        }
    }
}
