{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Column": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ColumnList": {
      "$ref": "#/definitions/List%3CColumn%3E"
    },
    "CombinedKeys": {
      "type": [
        "string"
      ]
    },
    "CombinedNumericElement": {
      "type": "number"
    },
    "CombinedStringElement": {
      "type": [
        "string",
        "number"
      ]
    },
    "List<Column>": {
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]+$": {
