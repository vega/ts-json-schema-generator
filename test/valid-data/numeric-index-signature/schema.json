        }
      },
      "type": "object"
    },
    "NumericAliasIndex": {
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]+$": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "NumericBase": {
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]+$": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "NumericChild": {
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]+$": {
          "type": "string"
        }
      },
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "NumericClass": {
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]+$": {
          "type": "string"
        }
      },
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "NumericElement": {
      "type": "boolean"
    },
    "NumericElementAtZero": {
      "type": "boolean"
    },
    "NumericIndex": {
      "additionalProperties": false,
      "patternProperties": {
