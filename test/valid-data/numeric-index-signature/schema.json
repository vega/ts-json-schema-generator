        },
        {
          "type": "number"
        }
      ]
    },
    "StringAndNumberIndex": {
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      },
      "patternProperties": {
        "^[0-9]+$": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "StringOrNumberKey": {
      "additionalProperties": {
        "type": "boolean"
      },
      "type": "object"
    }
  }
}
