          "type": "boolean"
        }
      },
      "type": "object"
    },
    "NumericIntersection": {
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]+$": {
          "type": "string"
        }
      },
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "NumericKeys": {
      "type": "number"
    },
    "NumericWithProperty": {
      "additionalProperties": false,
      "patternProperties": {
